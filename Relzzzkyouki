--[[     Relzzzkyouki     Fitur : Speed + Noclip (tembus tembok), Fly dengan speed yang bisa diatur     Cocok untuk Delta Executor (PC & Mobile)     Toggle menu: tombol "-" di pojok menu (minimize) atau tombol RightShift (PC) ]]  local Players = game:GetService("Players") local RunService = game:GetService("RunService") local UserInputService = game:GetService("UserInputService") local LocalPlayer = Players.LocalPlayer  -- Hapus GUI lama jika di-execute ulang pcall(function()     local old = (gethui and gethui() or game:GetService("CoreGui")):FindFirstChild("Relzzzkyouki")     if old then old:Destroy() end end)  -- ===================== STATE ===================== local State = {     Speed = false,     SpeedValue = 50,     Noclip = false,     Fly = false,     FlySpeed = 60,     Up = false,     Down = false, }  local function getChar() return LocalPlayer.Character end local function getHum()     local c = getChar()     return c and c:FindFirstChildOfClass("Humanoid") end local function getRoot()     local c = getChar()     return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")) end  -- ===================== GUI ===================== local gui = Instance.new("ScreenGui") gui.Name = "Relzzzkyouki" gui.ResetOnSpawn = false gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling local okParent = pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end) if not okParent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end  local main = Instance.new("Frame") main.Size = UDim2.new(0, 250, 0, 330) main.Position = UDim2.new(0.5, -125, 0.3, 0) main.BackgroundColor3 = Color3.fromRGB(20, 20, 28) main.BorderSizePixel = 0 main.Active = true main.Parent = gui Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10) local stroke = Instance.new("UIStroke", main) stroke.Color = Color3.fromRGB(170, 60, 255) stroke.Thickness = 1.5  local title = Instance.new("TextLabel") title.Size = UDim2.new(1, -40, 0, 32) title.Position = UDim2.new(0, 10, 0, 0) title.BackgroundTransparency = 1 title.Text = "Relzzzkyouki" title.Font = Enum.Font.GothamBold title.TextSize = 16 title.TextColor3 = Color3.fromRGB(200, 120, 255) title.TextXAlignment = Enum.TextXAlignment.Left title.Parent = main  local minBtn = Instance.new("TextButton") minBtn.Size = UDim2.new(0, 26, 0, 22) minBtn.Position = UDim2.new(1, -32, 0, 5) minBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55) minBtn.Text = "-" minBtn.Font = Enum.Font.GothamBold minBtn.TextSize = 16 minBtn.TextColor3 = Color3.new(1, 1, 1) minBtn.Parent = main Instance.new("UICorner", minBtn).CornerRadius = UDim.new(0, 6)  local body = Instance.new("Frame") body.Size = UDim2.new(1, 0, 1, -34) body.Position = UDim2.new(0, 0, 0, 34) body.BackgroundTransparency = 1 body.Parent = main  local layout = Instance.new("UIListLayout", body) layout.Padding = UDim.new(0, 6) layout.HorizontalAlignment = Enum.HorizontalAlignment.Center local pad = Instance.new("UIPadding", body) pad.PaddingTop = UDim.new(0, 2)  -- Drag (mouse & touch) do     local dragging, dragStart, startPos     title.InputBegan:Connect(function(i)         if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then             dragging = true             dragStart = i.Position             startPos = main.Position         end     end)     UserInputService.InputChanged:Connect(function(i)         if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then             local d = i.Position - dragStart             main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)         end     end)     UserInputService.InputEnded:Connect(function(i)         if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then             dragging = false         end     end) end  local minimized = false local function setMinimized(v)     minimized = v     body.Visible = not v     main.Size = v and UDim2.new(0, 250, 0, 32) or UDim2.new(0, 250, 0, 330)     minBtn.Text = v and "+" or "-" end minBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end) UserInputService.InputBegan:Connect(function(i, gp)     if not gp and i.KeyCode == Enum.KeyCode.RightShift then setMinimized(not minimized) end end)  -- Helper UI local function makeToggle(text, callback)     local b = Instance.new("TextButton")     b.Size = UDim2.new(1, -20, 0, 32)     b.BackgroundColor3 = Color3.fromRGB(40, 40, 55)     b.Font = Enum.Font.GothamMedium     b.TextSize = 14     b.TextColor3 = Color3.new(1, 1, 1)     b.Text = text .. " : OFF"     b.AutoButtonColor = true     b.Parent = body     Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)     local on = false     b.MouseButton1Click:Connect(function()         on = not on         b.Text = text .. " : " .. (on and "ON" or "OFF")         b.BackgroundColor3 = on and Color3.fromRGB(120, 40, 200) or Color3.fromRGB(40, 40, 55)         callback(on)     end)     return b end  local function makeSpeedRow(labelText, default, minV, maxV, onChange)     local row = Instance.new("Frame")     row.Size = UDim2.new(1, -20, 0, 32)     row.BackgroundTransparency = 1     row.Parent = body      local lbl = Instance.new("TextLabel")     lbl.Size = UDim2.new(0, 70, 1, 0)     lbl.BackgroundTransparency = 1     lbl.Text = labelText     lbl.Font = Enum.Font.Gotham     lbl.TextSize = 13     lbl.TextColor3 = Color3.fromRGB(210, 210, 220)     lbl.TextXAlignment = Enum.TextXAlignment.Left     lbl.Parent = row      local function btn(txt, x)         local b = Instance.new("TextButton")         b.Size = UDim2.new(0, 28, 0, 28)         b.Position = UDim2.new(0, x, 0, 2)         b.BackgroundColor3 = Color3.fromRGB(40, 40, 55)         b.Text = txt         b.Font = Enum.Font.GothamBold         b.TextSize = 16         b.TextColor3 = Color3.new(1, 1, 1)         b.Parent = row         Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)         return b     end      local minus = btn("-", 72)     local box = Instance.new("TextBox")     box.Size = UDim2.new(0, 60, 0, 28)     box.Position = UDim2.new(0, 104, 0, 2)     box.BackgroundColor3 = Color3.fromRGB(30, 30, 42)     box.Text = tostring(default)     box.Font = Enum.Font.GothamMedium     box.TextSize = 14     box.TextColor3 = Color3.new(1, 1, 1)     box.ClearTextOnFocus = false     box.Parent = row     Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)     local plus = btn("+", 168)      local value = default     local function set(v)         v = math.clamp(math.floor(v), minV, maxV)         value = v         box.Text = tostring(v)         onChange(v)     end     minus.MouseButton1Click:Connect(function() set(value - 10) end)     plus.MouseButton1Click:Connect(function() set(value + 10) end)     box.FocusLost:Connect(function()         local n = tonumber(box.Text)         set(n or value)     end)     set(default) end  local function makeLabel(text)     local l = Instance.new("TextLabel")     l.Size = UDim2.new(1, -20, 0, 18)     l.BackgroundTransparency = 1     l.Text = text     l.Font = Enum.Font.GothamBold     l.TextSize = 12     l.TextColor3 = Color3.fromRGB(170, 100, 240)     l.TextXAlignment = Enum.TextXAlignment.Left     l.Parent = body     return l end  -- ===================== UI CONTENT ===================== makeLabel("SPEED + NOCLIP") makeToggle("Speed", function(on)     State.Speed = on     if not on then         local h = getHum()         if h then h.WalkSpeed = 16 end     end end) makeSpeedRow("Kecepatan", State.SpeedValue, 16, 500, function(v) State.SpeedValue = v end) makeToggle("Noclip (tembus tembok)", function(on) State.Noclip = on end)  makeLabel("FLY") local flyToggleSetter makeToggle("Fly", function(on) flyToggleSetter(on) end) makeSpeedRow("Fly Speed", State.FlySpeed, 10, 500, function(v) State.FlySpeed = v end)  -- Tombol naik / turun (untuk mobile) local updown = Instance.new("Frame") updown.Size = UDim2.new(1, -20, 0, 32) updown.BackgroundTransparency = 1 updown.Parent = body  local function holdBtn(text, xScale, key)     local b = Instance.new("TextButton")     b.Size = UDim2.new(0.5, -4, 1, 0)     b.Position = UDim2.new(xScale, xScale == 0 and 0 or 4, 0, 0)     b.BackgroundColor3 = Color3.fromRGB(40, 40, 55)     b.Text = text     b.Font = Enum.Font.GothamMedium     b.TextSize = 13     b.TextColor3 = Color3.new(1, 1, 1)     b.Parent = updown     Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)     b.InputBegan:Connect(function(i)         if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then             State[key] = true         end     end)     b.InputEnded:Connect(function(i)         if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then             State[key] = false         end     end) end holdBtn("Naik (E)", 0, "Up") holdBtn("Turun (Q)", 0.5, "Down")  local hint = Instance.new("TextLabel") hint.Size = UDim2.new(1, -20, 0, 30) hint.BackgroundTransparency = 1 hint.Text = "PC: E naik, Q turun, RightShift sembunyikan menu" hint.TextWrapped = true hint.Font = Enum.Font.Gotham hint.TextSize = 11 hint.TextColor3 = Color3.fromRGB(150, 150, 165) hint.Parent = body  -- Keyboard naik/turun UserInputService.InputBegan:Connect(function(i, gp)     if gp then return end     if i.KeyCode == Enum.KeyCode.E then State.Up = true end     if i.KeyCode == Enum.KeyCode.Q then State.Down = true end end) UserInputService.InputEnded:Connect(function(i)     if i.KeyCode == Enum.KeyCode.E then State.Up = false end     if i.KeyCode == Enum.KeyCode.Q then State.Down = false end end)  -- ===================== LOGIC ===================== -- Speed RunService.Heartbeat:Connect(function()     if State.Speed and not State.Fly then         local h = getHum()         if h then h.WalkSpeed = State.SpeedValue end     end end)  -- Noclip RunService.Stepped:Connect(function()     if State.Noclip or State.Fly then         local c = getChar()         if c then             for _, p in ipairs(c:GetDescendants()) do                 if p:IsA("BasePart") and p.CanCollide then                     p.CanCollide = false                 end             end         end     end end)  -- Fly local bv, bg, flyConn  local function stopFly()     if flyConn then flyConn:Disconnect() flyConn = nil end     if bv then bv:Destroy() bv = nil end     if bg then bg:Destroy() bg = nil end     local h = getHum()     if h then         h.PlatformStand = false         h:ChangeState(Enum.HumanoidStateType.GettingUp)     end end  local function startFly()     stopFly()     local root, hum = getRoot(), getHum()     if not root or not hum then return end      hum.PlatformStand = true     bv = Instance.new("BodyVelocity")     bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)     bv.Velocity = Vector3.zero     bv.Parent = root      bg = Instance.new("BodyGyro")     bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)     bg.P = 9e4     bg.CFrame = root.CFrame     bg.Parent = root      flyConn = RunService.RenderStepped:Connect(function()         local r, h = getRoot(), getHum()         local cam = workspace.CurrentCamera         if not r or not h or not bv or not bg then return end          local move = h.MoveDirection         local vel = Vector3.zero         if 
